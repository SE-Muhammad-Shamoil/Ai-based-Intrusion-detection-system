# NetSentinel Backend Environment Variables

# Allowed CORS origin for frontend
FRONTEND_ORIGIN=http://localhost:3000

# File upload and processing limits
MAX_UPLOAD_MB=25
MAX_ROWS=5000

# Optional Anthropic API configuration for 'Explain with AI' feature
# If left empty, NetSentinel will automatically use a deterministic analyst template fallback.
ANTHROPIC_API_KEY=

# Example: claude-3-5-sonnet-20241022 (check Anthropic documentation for latest model IDs)
LLM_MODEL=
